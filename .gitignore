# secrets
.env
!.env.example
*cookies*.json
*.session

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# state
*.db
*.sqlite3

# local dev container state: Claude OAuth credentials + private digest archives
local-data/

# os / build
dist/
.DS_Store

# Claude Code agent worktrees (session-local, never part of the repo)
.claude/worktrees/

# wrangler local cache/state. workers/news-site/.gitignore already covers that
# subtree, but wrangler drops this wherever it is INVOKED -- run a `wrangler`
# command from the repo root (easy to do; the worker's npm scripts are not the
# only entry point) and .wrangler/cache/wrangler-account.json lands here
# untracked and un-ignored, carrying the Cloudflare account id. Unanchored so
# it matches at any depth.
.wrangler/

# Structurizr working state and rendered output. The DSL in docs/architecture/
# is the source; workspace.json, the lock dir and generated/ are all derived,
# and `make export` rewrites them wholesale.
docs/architecture/workspace.json
docs/architecture/.structurizr/
docs/architecture/generated/
