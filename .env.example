# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Phase 1: Telegram collector (required) ---

# my.telegram.org app id
TG_API_ID=123456
# my.telegram.org app hash
TG_API_HASH=your_telegram_api_hash
# Telethon StringSession from `uv run python scripts/telegram_login.py` (secret)
TG_SESSION=your_telethon_string_session
# Comma-separated Telegram chat/group ids to collect from
TG_CHAT_ALLOWLIST=-1001234567890,-1009876543210

# --- Optional, has a default ---

# SQLite state db path (default: ./state.db)
STATE_DB_PATH=./state.db
# Master switch for the X collector (default: false) — Phase 3
X_ENABLED=false

# --- Phase 2: summarizer + email (required for Phase 2) ---

# Claude model used by `claude -p` (default: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5
# Points the Claude CLI at the persisted config/credentials dir so the
# Max-subscription login survives across runs. No API key involved. Not
# read by digest/config.py (the `claude` CLI reads it directly from the
# process environment) — set it in the deploy environment, not required
# for local `.env` testing.
# CLAUDE_CONFIG_DIR=/srv/appdata/digest/claude-home
# CLAUDE_TIMEOUT_SECONDS=300
# Claude CLI reasoning effort: one of low, medium, high, xhigh, max
# (default: high). An A/B on real digests showed high materially beats the
# CLI default on editorial judgment, while max was near-identical output for
# 65% more wall-clock -- so high is the default, not max. Raising this
# consumes more of the Max subscription's shared usage limits on every one
# of the 8 unattended runs this job makes per day.
# CLAUDE_EFFORT=high

# iCloud Custom Email Domain SMTP (smtp.mail.me.com:587, STARTTLS)
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
# iCloud account username (secret)
SMTP_USER=your_icloud_username
# iCloud app-specific password, generated at account.apple.com (secret)
SMTP_PASSWORD=your_icloud_app_specific_password
DIGEST_FROM=digest@tomhorvath.me
# Display name shown alongside DIGEST_FROM in the mail client's sender field
# (default: Digest)
DIGEST_FROM_NAME=Digest
DIGEST_TO=tom@tomhorvath.me
# Markdown archive dir (default: ./archive)
ARCHIVE_DIR=./archive
# Comma-separated RSS/Atom feed URLs (AI/robotics news). No separate on/off
# flag -- the news collector is enabled iff this is non-empty.
# NEWS_FEEDS=https://example.com/feed.xml,https://another.example/rss

# --- Phase 3: X collector (required only when X_ENABLED=true) ---

# Cookie-based auth only -- twikit never performs a fresh username/password
# login on a scheduled run (ban-risk mitigation, PLAN.md §4.3/§8). Exactly
# ONE of the two vars below is required when X_ENABLED=true; setting both,
# or neither, is a ConfigError.
X_COOKIES_PATH=/srv/appdata/digest/x-cookies.json
# Alternative to X_COOKIES_PATH: inline cookie JSON instead of a file path.
# X_COOKIES={"ct0": "...", "auth_token": "..."}
