# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Phase 1: Telegram collector (required) ---

# my.telegram.org app id
TG_API_ID=123456
# my.telegram.org app hash
TG_API_HASH=your_telegram_api_hash
# Telethon StringSession from `uv run python scripts/telegram_login.py` (secret)
TG_SESSION=your_telethon_string_session
# Comma-separated Telegram chat/group ids to collect from
TG_CHAT_ALLOWLIST=-1001234567890,-1009876543210

# --- Optional, has a default ---

# SQLite state db path (default: ./state.db)
STATE_DB_PATH=./state.db
# Master switch for the X collector (default: false) — Phase 3
X_ENABLED=false

# --- Phase 2: summarizer + email (required for Phase 2) ---

# Claude model used by `claude -p` (default: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5
# REQUIRED. Long-lived token from `claude setup-token` (Max subscription, no
# API key). Not read by digest/config.py — claude_subprocess_env() forwards it
# to the `claude` CLI, which reads it from its own process environment.
# Without it the summarizer fails "Not logged in".
CLAUDE_CODE_OAUTH_TOKEN=
# Optional. Where the CLI keeps its own state. There is no default any more:
# nothing auth-related lives there, so leaving it unset lets the CLI use an
# ephemeral dir in the container. Set it only if you want a specific location.
# CLAUDE_CONFIG_DIR=/tmp/claude-home
# CLAUDE_TIMEOUT_SECONDS=300
# Claude CLI reasoning effort: one of low, medium, high, xhigh, max
# (default: high). An A/B on real digests showed high materially beats the
# CLI default on editorial judgment, while max was near-identical output for
# 65% more wall-clock -- so high is the default, not max. Raising this
# consumes more of the Max subscription's shared usage limits on every one
# of the unattended runs this job makes per day (4 window runs, plus the
# daily, the weekly, and the patreon/positions lanes).
# CLAUDE_EFFORT=high

# iCloud Custom Email Domain SMTP (smtp.mail.me.com:587, STARTTLS)
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
# iCloud account username (secret)
SMTP_USER=your_icloud_username
# iCloud app-specific password, generated at account.apple.com (secret)
SMTP_PASSWORD=your_icloud_app_specific_password
DIGEST_FROM=digest@tomhorvath.me
# Display name shown alongside DIGEST_FROM in the mail client's sender field
# (default: Digest)
DIGEST_FROM_NAME=Digest
DIGEST_TO=tom@tomhorvath.me
# Markdown archive dir (default: ./archive)
ARCHIVE_DIR=./archive
# Comma-separated RSS/Atom feed URLs (AI/robotics news). No separate on/off
# flag -- the news collector is enabled iff this is non-empty.
# NEWS_FEEDS=https://example.com/feed.xml,https://another.example/rss

# --- Positions tracker (`python -m digest positions`, own 4-hourly timer) ---
#
# The projects the owner holds a position in, tracked in their OWN Telegram
# topic rather than inside the 6-hourly briefing. Items matching ANY of the
# three variables below are claimed by that run and REMOVED from the window
# digest -- there is no double coverage, by construction
# (digest/positions.py). Unset all three and the feature is off; the window
# digest then treats these channels as ordinary Telegram traffic, exactly as
# it did before.
#
# Telegram public-channel usernames (no @ / t.me/ prefix).
# POSITIONS_TG_CHANNELS=ASI_Alliance,fetchunofficial
#
# X screen names, with or without a leading @.
#
# DEPLOY CHECKLIST -- these only work if POST NOTIFICATIONS (the bell) are
# enabled for each account in the X app. The X collector fetches an
# account's own posts only when a notification names it
# (digest/collectors/x.py, "Phase 2"); an account listed here without the
# bell on is not an error and cannot be detected from inside this service --
# it simply never matches anything and looks like a quiet account.
# POSITIONS_X_ACCOUNTS=ASI_Alliance,Fetch_ai,SingularityNET,CUDOS_,HMsheikh4,ASI_Researchers
#
# Free-text terms that pull an item into the tracker from ANY source, so a
# story about the project is claimed out of a general crypto channel or a
# news feed instead of staying in the briefing. Case-insensitive substring
# match against the item's text; entries must be at least 4 characters.
#
# KEEP THESE DISTINCTIVE. The error cost is asymmetric: a false positive
# removes the story from the briefing, and if the tracker then judges that
# window immaterial the item is absorbed as a quiet-window record -- so an
# over-broad term makes unrelated stories vanish from every channel
# silently. Use cashtags and proper names; never a bare ASI or FET ("basic"
# contains "asi", "feta" contains "fet").
# POSITIONS_KEYWORDS=$FET,$ASI,Fetch.ai,SingularityNET,Artificial Superintelligence Alliance,ASI:One,ASI:Cloud,Ocean Protocol,CUDOS
#
# A `$` here is literal ONLY because this file is read by python-dotenv. The
# deployed env file is read by Docker Compose, which INTERPOLATES env_file
# values -- `$FET` there expands to empty against an undefined shell
# variable and the keyword disappears without any error. The homelab role's
# digest.env.j2 doubles every `$` for exactly that reason; anything writing
# this file for a container must do the same.

# --- Relay (`python -m digest relay`, own hourly timer) ---
#
# Public channels whose NEW posts are forwarded VERBATIM into the hub topic
# with Telegram's native forward (media, albums and the "Forwarded from"
# header intact) -- no summarization, no items/digests rows, only a cursor
# per channel. First run seeds the cursor and forwards nothing; never a
# history backfill. Forwarded by the owner's own user session (TG_SESSION),
# so TELEGRAM_NOTIFY_CHAT_ID must be set and NUMERIC when this is set; the
# bot token is not needed. Bare usernames, no @ / t.me/ prefix. Unset = off.
# RELAY_TG_CHANNELS=Disaster_News

# --- Phase 3: X collector (required only when X_ENABLED=true) ---

# Cookie-based auth only -- twikit never performs a fresh username/password
# login on a scheduled run (ban-risk mitigation, PLAN.md §4.3/§8). Exactly
# ONE of the two vars below is required when X_ENABLED=true; setting both,
# or neither, is a ConfigError.
X_COOKIES_PATH=/srv/appdata/digest/x-cookies.json
# Alternative to X_COOKIES_PATH: inline cookie JSON instead of a file path.
# X_COOKIES={"ct0": "...", "auth_token": "..."}

# --- Hacker News collector (optional, no auth) ---

# Master switch for the Hacker News collector (default: false). Public
# Algolia HN Search API (hn.algolia.com) -- no auth, no API key.
HACKERNEWS_ENABLED=false
# How many front-page stories to request per run (default: 15, range 1-30).
# HACKERNEWS_TOP_N=15

# --- Reddit collector (optional) ---

# Master switch (default: false). When true, REDDIT_SESSION_COOKIE and
# REDDIT_SUBREDDITS are both REQUIRED -- the app refuses to start without
# them rather than silently collecting nothing.
REDDIT_ENABLED=false
# Session cookie for the owner's own Reddit account (SECRET).
# REDDIT_SESSION_COOKIE=
# Subreddit names WITHOUT the "r/" prefix, comma-separated.
# REDDIT_SUBREDDITS=Futurology,LocalLLaMA
# How many top posts to pull per subreddit per run.
# REDDIT_POSTS_PER_SUB=10

# --- Patreon collector (optional) ---

# Enabled iff BOTH are set (no separate PATREON_ENABLED flag, mirroring
# NEWS_FEEDS' empty-means-disabled shape). Setting exactly ONE is a
# half-finished deploy and the app refuses to start -- deliberately, since
# a Patreon ConfigError aborts the whole run, not just this collector.
# The campaign id is the numeric id behind a creator page, resolvable from
# /api/campaigns?filter[vanity]=<name>. The cookie is the owner's own
# patreon.com session_id (SECRET) -- a live credential to a PAID account,
# valid roughly a year; refresh it by re-logging into Patreon in a browser
# and reading the cookie back out.
# PATREON_CAMPAIGN_ID=
# PATREON_SESSION_COOKIE=

# --- Polymarket collector (optional) ---

POLYMARKET_ENABLED=false
# Endpoint and its key (SECRET) -- reached through a proxy, not directly.
# POLYMARKET_API_BASE=
# POLYMARKET_PROXY_KEY=
# How many markets to report, and the probability move that makes one
# notable enough to mention.
# POLYMARKET_TOP_N=
# POLYMARKET_SWING_THRESHOLD=

# --- Summarization tuning ---

# Per summarize call. The default here is 300; the deployment sets 600.
# CLAUDE_TIMEOUT_SECONDS=300
# low | medium | high | xhigh | max (default: high).
# CLAUDE_EFFORT=high

# --- Hungarian translation (optional) ---

TRANSLATE_HU_ENABLED=false
# Primary translation model, and the model retried when the primary is
# refused by the safety classifier. Set the fallback to an empty string to
# disable the retry and re-raise the refusal instead.
# TRANSLATE_MODEL=sonnet
# TRANSLATE_MODEL_FALLBACK=claude-sonnet-4-6
# Applies to EACH leg, so the worst case is 2x this value when a refusal
# sends the primary call to the fallback model. Size systemd's
# TimeoutStartSec against the doubled figure, not this one.
# TRANSLATE_TIMEOUT_SECONDS=300

# --- OpenRouter fallback chain (optional) ---
#
# When `claude -p` fails for ANY reason -- a safeguards refusal, the Max
# subscription's usage limit, a timeout, empty output -- the same prompt is
# retried against these OpenRouter models in order. The API key is the master
# switch: unset means no fallback legs anywhere and behaviour identical to
# before this feature existed. digest/verify.py is deliberately NOT covered --
# it is the only call that runs WITH web tools, which no fallback can provide.
# OPENROUTER_API_KEY=
#
# Two tiers, matching the two primary tiers. The editorial list backs every
# call that summarizes with ANTHROPIC_MODEL (window, daily, weekly, positions,
# patreon); the light list backs TRANSLATE_MODEL/CONTEXT_MODEL work. Both are
# comma-separated OpenRouter "<provider>/<model>" ids, validated at startup so
# a typo is a ConfigError rather than a leg that only fails during an outage.
# UNSET keeps the defaults below; explicitly EMPTY disables that tier.
# FALLBACK_MODELS=openai/gpt-5.6-sol,z-ai/glm-5.3
# FALLBACK_LIGHT_MODELS=openai/gpt-5.6-terra,deepseek/deepseek-v4-flash
#
# Wall-clock budget SHARED by all legs of one call (not per leg), and the
# clock starts when the Claude primary FAILS -- so one call's worst case is
# the primary's own timeout plus this, which is what systemd's
# TimeoutStartSec is sized against.
# FALLBACK_TIMEOUT_SECONDS=180

# --- Daily-brief verification pass (optional) ---

VERIFY_DAILY_ENABLED=false
# Agentic (WebSearch/WebFetch in a loop), so it needs a longer budget than
# a toolless summarize call. MAX_WEB_OPS is prompt-level guidance the model
# polices itself with -- the CLI has no hard tool-call budget flag.
# VERIFY_DAILY_TIMEOUT_SECONDS=600
# VERIFY_DAILY_MAX_WEB_OPS=20
# Both default to ANTHROPIC_MODEL / CLAUDE_EFFORT when unset.
# VERIFY_DAILY_MODEL=
# VERIFY_DAILY_EFFORT=

# --- Story-arc context primers (optional) ---

# Generated AFTER the daily brief has already shipped, so a failure here
# can never delay or degrade the brief itself.
CONTEXT_ENABLED=false
# CONTEXT_MAX_PER_RUN=
# CONTEXT_MODEL=sonnet
# CONTEXT_TIMEOUT_SECONDS=120

# --- Delivery channels ---

# The app REFUSES TO START with every channel disabled. Email is the role
# default and stays fully implemented so a host that configures nothing else
# keeps working; on the owner's own deployment email is off and the live
# channels are the news site and the Telegram ping.
EMAIL_ENABLED=true

# News site (Cloudflare D1 Worker). SITE_INGEST_KEY is a SECRET.
# SITE_PUBLISH_URL=
# SITE_INGEST_KEY=
# Public base used to build reader-facing links back to the site.
# SITE_PUBLIC_BASE=
# Send story-arc keys along with the site payload (default: true).
# ARC_KEYS_SITE_ENABLED=true

# Telegram TL;DR ping. Bot token is a SECRET. The thread ids are forum
# topics: unset DAILY/WEEKLY means those briefs land in the window topic,
# which is a valid choice, not a misconfiguration.
# TELEGRAM_NOTIFY_BOT_TOKEN=
# TELEGRAM_NOTIFY_CHAT_ID=
# TELEGRAM_NOTIFY_THREAD_ID=
# TELEGRAM_DAILY_THREAD_ID=
# TELEGRAM_WEEKLY_THREAD_ID=
# Forum topics for the modes outside the window -> daily -> weekly cascade
# (kind="patreon", kind="positions", and the relay -- which creates no
# digest at all and is routed by main.py directly), same unset-falls-back-
# to-the-window-topic contract as DAILY/WEEKLY above. Note that `0` is a
# REAL value for every thread id here (post to the group root), so leaving
# the variable unset is the only way to say "not configured".
# TELEGRAM_PATREON_THREAD_ID=
# TELEGRAM_POSITIONS_THREAD_ID=
# TELEGRAM_RELAY_THREAD_ID=

# --- Operations ---

# How old an unsummarized item must get before a run logs a `stale_backlog`
# WARNING naming its source (default: 24 hours = 4 window runs). Detects a
# source that has stopped DRAINING, which is otherwise invisible: a starved
# lane never fails a run, so systemd's OnFailure hook never fires for it.
# Report-only -- nothing retries, reschedules, or changes the exit code.
# Keep it well above one window (a single window's leftovers are normal and
# drain on the next run) and well below the 14-day stale-item prune.
# STALE_BACKLOG_WARN_HOURS=24
