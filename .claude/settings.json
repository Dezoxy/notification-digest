{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv lock:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python scripts/:*)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run golden)",
      "Bash(npm run lint:*)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(npm publish:*)",
      "Bash(uv publish:*)",
      "Read(./.env)",
      "Read(./**/*.session)",
      "Read(./**/*cookies*.json)",
      "Read(./local-data/**)"
    ]
  }
}
