# Declared configuration from homelab defaults + host_vars on 2026-10-08.
# Review parity against the final live configuration before cutover.
# Copy reviewed configuration to an ignored local file or repository variable.
# Personal identifiers below are placeholders. Secret values are copied separately.
# All secret names resolve in the dedicated digest vault, never the homelab vault.
storage_account_name = "REPLACE_WITH_GLOBALLY_UNIQUE_NAME"
backup_storage_account_name = "REPLACE_WITH_DIFFERENT_UNIQUE_NAME"
ghcr_username = "Dezoxy"
key_vault_name = "REPLACE_WITH_UNIQUE_VAULT_NAME"
alert_email = "REPLACE@example.com"
budget_start_date = "2026-10-01T00:00:00Z"
jobs_enabled = false
schedules_enabled = false
migration_release_verified = false
# The image is NOT set here: it is pinned in the tracked image.auto.tfvars.json.

app_env = {
  TG_CHAT_ALLOWLIST = "REPLACE_WITH_CHAT_IDS"
  SMTP_HOST = "smtp.mail.me.com"
  SMTP_PORT = "587"
  DIGEST_FROM = "digest@example.com"
  DIGEST_FROM_NAME = "My Digest"
  DIGEST_TO = "owner@example.com"
  ANTHROPIC_MODEL = "claude-opus-5-5"
  CLAUDE_TIMEOUT_SECONDS = "600"
  CLAUDE_EFFORT = "high"
  CLAUDE_CONFIG_DIR = "/tmp/claude-home"
  DISABLE_AUTOUPDATER = "1"
  X_ENABLED = "true"
  NEWS_FEEDS = "https://www.theverge.com/rss/ai-artificial-intelligence/index.xml,https://arstechnica.com/ai/feed/,https://techcrunch.com/category/artificial-intelligence/feed/,https://spectrum.ieee.org/feeds/topic/robotics.rss,https://the-decoder.com/feed/,https://simonwillison.net/atom/everything/,https://www.therobotreport.com/feed/,https://importai.substack.com/feed,https://feeds.bbci.co.uk/news/world/rss.xml,https://www.aljazeera.com/xml/rss/all.xml,https://feedx.net/rss/ap.xml,https://www.politico.eu/feed/,https://telex.hu/rss,https://www.portfolio.hu/rss/all.xml,https://www.ft.com/world?format=rss"
  POSITIONS_TG_CHANNELS = "ASI_Alliance,fetchunofficial,AGIPriceTalks"
  POSITIONS_X_ACCOUNTS = "ASI_Alliance,Fetch_ai,SingularityNET,CUDOS_,HMsheikh4,ASI_Researchers"
  POSITIONS_KEYWORDS = "$FET,$ASI,Fetch.ai,SingularityNET,Artificial Superintelligence Alliance,ASI:One,ASI:Cloud,Ocean Protocol,CUDOS"
  RELAY_TG_CHANNELS = "Disaster_News"
  HACKERNEWS_ENABLED = "true"
  HACKERNEWS_TOP_N = "15"
  REDDIT_ENABLED = "true"
  REDDIT_SUBREDDITS = "Futurology,LocalLLaMA,MachineLearning,news,hungary"
  POLYMARKET_ENABLED = "true"
  POLYMARKET_API_BASE = "https://polymarket-proxy.toomhorvath.workers.dev"
  EMAIL_ENABLED = "false"
  SITE_PUBLISH_URL = "https://news-site.toomhorvath.workers.dev"
  TELEGRAM_WEEKLY_THREAD_ID = "REPLACE_WITH_THREAD_ID"
  TELEGRAM_PATREON_THREAD_ID = "REPLACE_WITH_THREAD_ID"
  TELEGRAM_POSITIONS_THREAD_ID = "REPLACE_WITH_THREAD_ID"
  TELEGRAM_RELAY_THREAD_ID = "REPLACE_WITH_THREAD_ID"
  PATREON_CAMPAIGN_ID = "REPLACE_WITH_CAMPAIGN_ID"
  TRANSLATE_HU_ENABLED = "true"
  TRANSLATE_MODEL = "claude-sonnet-5-5"
  TRANSLATE_EFFORT = "high"
  TRANSLATE_TIMEOUT_SECONDS = "300"
  VERIFY_DAILY_ENABLED = "true"
  VERIFY_DAILY_TIMEOUT_SECONDS = "300"
  VERIFY_DAILY_MAX_WEB_OPS = "20"
  CONTEXT_ENABLED = "true"
  CONTEXT_MAX_PER_RUN = "1"
  # Claude API fallback over workload identity federation (identifiers, not
  # secrets; all five or none). See docs/azure-migration.md.
  ANTHROPIC_FEDERATION_RULE_ID = "fdrl_REPLACE_WITH_RULE_ID"
  ANTHROPIC_ORGANIZATION_ID = "REPLACE_WITH_CONSOLE_ORGANIZATION_UUID"
  ANTHROPIC_SERVICE_ACCOUNT_ID = "svac_REPLACE_WITH_SERVICE_ACCOUNT_ID"
  ANTHROPIC_FEDERATION_AUDIENCE = "api://REPLACE_WITH_AUDIENCE_APP_ID"
  ANTHROPIC_FEDERATION_TENANT_ID = "REPLACE_WITH_ENTRA_TENANT_ID"
}

secret_names = {
  TG_API_ID = "digest-tg-api-id"
  TG_API_HASH = "digest-tg-api-hash"
  TG_SESSION = "digest-tg-session"
  SMTP_USER = "digest-smtp-user"
  SMTP_PASSWORD = "digest-smtp-password"
  CLAUDE_CODE_OAUTH_TOKEN = "digest-claude-oauth-token"
  REDDIT_SESSION_COOKIE = "digest-reddit-session"
  POLYMARKET_PROXY_KEY = "digest-polymarket-proxy-key"
  SITE_INGEST_KEY = "digest-site-ingest-key"
  SITE_PUBLIC_BASE = "digest-site-public-base"
  TELEGRAM_NOTIFY_BOT_TOKEN = "digest-telegram-notify-bot-token"
  TELEGRAM_NOTIFY_CHAT_ID = "digest-telegram-notify-chat-id"
  TELEGRAM_NOTIFY_THREAD_ID = "digest-telegram-notify-thread-id"
  TELEGRAM_DAILY_THREAD_ID = "digest-telegram-daily-thread-id"
  PATREON_SESSION_COOKIE = "digest-patreon-session-cookie"
  GHCR_PULL_TOKEN = "digest-ghcr-pull-token"
}
# No fallback API key is mapped on purpose: the fallback authenticates with the
# managed identity through workload identity federation, so there is nothing
# to store here.
