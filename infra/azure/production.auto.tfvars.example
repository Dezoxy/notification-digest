storage_account_name = "REPLACE_WITH_GLOBALLY_UNIQUE_NAME"
ghcr_username = "Dezoxy"
key_vault_resource_id = "/subscriptions/522caf52-0fb9-4b3b-acb9-006c120306dd/resourceGroups/rg-homelab-secrets/providers/Microsoft.KeyVault/vaults/kv-homelab-prod-th"
alert_email = "REPLACE@example.com"
budget_start_date = "2026-10-01T00:00:00Z"
schedules_enabled = false
migration_release_verified = false
image = "ghcr.io/dezoxy/notification-digest:0.28.0"

app_env = {
  TG_CHAT_ALLOWLIST = "-1001358788312,-1001277327948,-1001994655615,-1001534592031,-1001993180528,-1001770853167,-1001683536966,-1001301968221,-1001220282322,-1001933319598,-1001700689119,-1002006131201,-1001556054753,-1002520657240,-1001963527562"
  SMTP_HOST = "smtp.mail.me.com"
